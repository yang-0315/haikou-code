<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 0 }}>
  <Box style={{ position: 'relative', width: '100%', height: '100%', flexDirection: 'column' }}>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: '100%', height: 12, background: '#1E4FA8' }} />
    <Box style={{ position: 'relative', flex: 1, padding: '0 80px', justifyContent: 'center' }}>
      <Text style={{ fontSize: 42, fontWeight: 'bold', color: '#1E4FA8', marginBottom: 28 }}>进度小结</Text>
      <Box style={{ flexDirection: 'column', gap: 18 }}>
        {[
          ['覆盖完成', '1,248 份语料、检索 100%、效力判定全量'],
          ['测试通过', '自研 19/19、审计 12 项全过、validity-QA 84/84'],
          ['仍在推进', '条款直引率、独立盲评、时点补证、反馈式路由'],
        ].map((r, i) => (
          <Box key={i} style={{ flexDirection: 'row', gap: 20, alignItems: 'center' }}>
            <Box style={{ width: 8, height: 8, background: '#3D7BD9', borderRadius: 4 }} />
            <Text style={{ fontSize: 22, fontWeight: 600, color: '#1A2230', width: 130 }}>{r[0]}</Text>
            <Text style={{ fontSize: 20, color: '#4A5568', flex: 1 }}>{r[1]}</Text>
          </Box>
        ))}
      </Box>
      <Text style={{ fontSize: 44, fontWeight: 'bold', color: '#1A2230', marginTop: 64 }}>谢谢</Text>
    </Box>
    <Box style={{ position: 'relative', padding: '0 80px 50px 80px' }}>
      <Box style={{ height: 1, background: '#D6DCE5', marginBottom: 18 }} />
      <Text style={{ fontSize: 15, color: '#8B97A8' }}>项目进度汇报 · 2026-11-22</Text>
    </Box>
  </Box>
</Slide>
