<Slide style={{ width: 1280, height: 720, background: 'linear-gradient(125deg, #0A2342 0%, #103A67 52%, #16457C 100%)', padding: 0 }}>
  <Box style={{ position: 'relative', width: '100%', height: '100%' }}>

    {/* 右侧抽象几何装饰 */}
    <Box style={{ position: 'absolute', top: 0, right: 0, width: 640, height: 720 }}>
      <svg width={640} height={720} viewBox='0 0 640 720'>
        <circle cx='470' cy='330' r='300' fill='none' stroke='#4C8FE0' strokeWidth='1' opacity='0.18' />
        <circle cx='470' cy='330' r='240' fill='none' stroke='#4C8FE0' strokeWidth='1' opacity='0.24' />
        <circle cx='470' cy='330' r='180' fill='none' stroke='#00C2D6' strokeWidth='1.5' opacity='0.32' />
        <circle cx='470' cy='330' r='120' fill='none' stroke='#E8B75A' strokeWidth='2' opacity='0.55' />
        <circle cx='470' cy='330' r='58' fill='#00C2D6' opacity='0.10' />
        <path d='M470 30 L470 630 M170 330 L770 330' stroke='#4C8FE0' strokeWidth='1' opacity='0.14' />
        <path d='M262 122 L678 538 M678 122 L262 538' stroke='#4C8FE0' strokeWidth='1' opacity='0.10' />
        <circle cx='470' cy='330' r='7' fill='#E8B75A' />
        <circle cx='650' cy='330' r='5' fill='#00C2D6' opacity='0.8' />
        <circle cx='470' cy='510' r='5' fill='#00C2D6' opacity='0.8' />
        <circle cx='290' cy='210' r='4' fill='#E8B75A' opacity='0.7' />
        <circle cx='620' cy='180' r='4' fill='#E8B75A' opacity='0.6' />
      </svg>
    </Box>

    {/* 顶部金色细条 */}
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 300, height: 6, background: 'linear-gradient(90deg, #E8B75A 0%, #00C2D6 100%)' }} />

    {/* 左侧竖线 */}
    <Box style={{ position: 'absolute', top: 188, left: 78, width: 4, height: 232, background: 'linear-gradient(180deg, #E8B75A 0%, #00C2D6 100%)', borderRadius: 2 }} />

    {/* 主内容 */}
    <Box style={{ position: 'relative', zIndex: 1, padding: '0 110px', justifyContent: 'center', height: '100%' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 26 }}>
        <Box style={{ width: 30, height: 2, background: '#E8B75A' }} />
        <Text style={{ fontSize: 16, color: '#E8B75A', fontWeight: 600, letterSpacing: 3 }}>PROJECT PROGRESS REPORT</Text>
      </Box>
      <Text style={{ fontSize: 60, fontWeight: 'bold', color: '#FFFFFF', lineHeight: 1.18 }}>
        海南自贸港政策文档<br />问答与比对系统
      </Text>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 18, marginTop: 30 }}>
        <Text style={{ fontSize: 34, color: '#00D4E8', fontWeight: 600 }}>项目进度汇报</Text>
        <Box style={{ width: 56, height: 2, background: 'rgba(255,255,255,0.35)' }} />
        <Text style={{ fontSize: 18, color: '#AFC6E4' }}>2026 · 11</Text>
      </Box>
      <Text style={{ fontSize: 19, color: '#B8CDE8', marginTop: 22, lineHeight: 1.6 }}>
        语料与索引建设 · 本轮测试数据 · 现存问题与下一步
      </Text>
    </Box>

    {/* 底部信息条 */}
    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: '100%', padding: '22px 110px', background: 'rgba(4,18,38,0.45)' }}>
      <Box style={{ height: 1, background: 'linear-gradient(90deg, rgba(232,183,90,0.7) 0%, rgba(0,194,214,0.4) 40%, transparent 100%)', marginBottom: 16 }} />
      <Box style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
          <FAIcon name='calendar' style={{ fill: '#8FB3DC', width: 16, height: 16 }} />
          <Text style={{ fontSize: 15, color: '#AFC6E4' }}>汇报日期：2026 年 11 月 22 日</Text>
        </Box>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10 }}>
          <FAIcon name='code' style={{ fill: '#8FB3DC', width: 16, height: 16 }} />
          <Text style={{ fontSize: 15, color: '#AFC6E4' }}>github.com/yang-0315/haikou-code</Text>
        </Box>
      </Box>
    </Box>
  </Box>
</Slide>
