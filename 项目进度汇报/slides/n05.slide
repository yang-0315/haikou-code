<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 0 }}>
  <Box style={{ width: '100%', height: '100%', flexDirection: 'column' }}>
    <Box style={{ height: 72, background: '#C0392B', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 60px' }}>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>存在的问题 ① 数据质量</Text>
      <Text style={{ fontSize: 16, color: '#F5C6C0' }}>03 · ISSUES (1/3)</Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', padding: '14px 60px 0 60px' }}>
      {[
        {
          n: '1', t: '条款可直引率仅 27%',
          a: '2,839 事项中仅 27% 能直引原文，其余只给事项名＋法律名＋核对提示。',
          b: '网页正文列式摊平，改从 PDF 用字符坐标还原 6 列；后段章节列位偏移。',
          c: '这部分回答不能引原文，用户须自行核对，削弱可溯源性。',
          d: '按章节做列模板或争取官方 Excel 版（最高优先级）。',
        },
        {
          n: '2', t: '156 份缺明确施行日',
          a: '1,248 份入时点索引：明确施行日 635、发布型 305、需补证 156。',
          b: '源网页未写施行日；发布型按发布日处理，法规类缺日期无法推断。',
          c: '涉及时点查询时只能保守降为"效力存疑"，无法给确定答案。',
          d: '待补队列在 review_queue.csv，按官方来源补填后回灌。',
        },
        {
          n: '3', t: '712 份没有文号',
          a: '1,248 份中仅 536 份有文号，其余 712 份只能靠标题检索。',
          b: '源网页标题／文头未含或未被抽到文号。',
          c: '标题带"试行／修订版"变体时易漏检，削弱文号主键稳定性。',
          d: '中优先级：补文号抽取，扩大检索覆盖。',
        },
        {
          n: '4', t: '废止决定附件漏列',
          a: '1 份决定标题声明废止 4 件，正文只列出 1 件。',
          b: '其余 3 件疑似写在附件中，当前链路只解析正文。',
          c: '可能导致这 3 件继续被判现行有效 —— 危险的漏报。',
          d: '闸门已记录为待核验，未误判为通过；待补附件解析。',
        },
      ].map((it, i) => (
        <Box key={i} style={{ borderLeft: '4px solid #C0392B', background: i % 2 === 0 ? '#F7F9FC' : '#FFFFFF', padding: '8px 14px', marginBottom: 9 }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 10, marginBottom: 4 }}>
            <Text style={{ fontSize: 17, fontWeight: 'bold', color: '#C0392B' }}>{it.n}</Text>
            <Text style={{ fontSize: 19, fontWeight: 600, color: '#1A2230' }}>{it.t}</Text>
          </Box>
          <Box style={{ flexDirection: 'row', gap: 16, marginBottom: 4 }}>
            <Box style={{ flex: 1, flexDirection: 'row', gap: 6 }}>
              <Text style={{ fontSize: 13.5, fontWeight: 600, color: '#C0392B' }}>现象</Text>
              <Text style={{ fontSize: 13.5, color: '#4A5568', lineHeight: 1.4, flex: 1 }}>{it.a}</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'row', gap: 6 }}>
              <Text style={{ fontSize: 13.5, fontWeight: 600, color: '#C0392B' }}>成因</Text>
              <Text style={{ fontSize: 13.5, color: '#4A5568', lineHeight: 1.4, flex: 1 }}>{it.b}</Text>
            </Box>
          </Box>
          <Box style={{ flexDirection: 'row', gap: 16 }}>
            <Box style={{ flex: 1, flexDirection: 'row', gap: 6 }}>
              <Text style={{ fontSize: 13.5, fontWeight: 600, color: '#1E4FA8' }}>影响</Text>
              <Text style={{ fontSize: 13.5, color: '#4A5568', lineHeight: 1.4, flex: 1 }}>{it.c}</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'row', gap: 6 }}>
              <Text style={{ fontSize: 13.5, fontWeight: 600, color: '#1E4FA8' }}>处理</Text>
              <Text style={{ fontSize: 13.5, color: '#1A2230', fontWeight: 600, lineHeight: 1.4, flex: 1 }}>{it.d}</Text>
            </Box>
          </Box>
        </Box>
      ))}
    </Box>

    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 60px' }}>
      <Text style={{ fontSize: 14, color: '#8B97A8' }}>项目进度汇报 · 2026-11-22</Text>
      <Text style={{ fontSize: 14, color: '#8B97A8' }}>05 / 09</Text>
    </Box>
  </Box>
</Slide>
