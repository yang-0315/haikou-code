<Slide style={{ width: 1280, height: 720, background: 'linear-gradient(125deg, #0A2342 0%, #103A67 52%, #16457C 100%)', padding: 0 }}>
  <Box style={{ position: 'relative', width: '100%', height: '100%' }}>
    {/* 装饰 */}
    <Box style={{ position: 'absolute', top: 0, right: 0, width: 520, height: 720, opacity: 0.5 }}>
      <svg width={520} height={720} viewBox='0 0 520 720'>
        <circle cx='400' cy='360' r='280' fill='none' stroke='#4C8FE0' strokeWidth='1' opacity='0.16' />
        <circle cx='400' cy='360' r='210' fill='none' stroke='#4C8FE0' strokeWidth='1' opacity='0.22' />
        <circle cx='400' cy='360' r='140' fill='none' stroke='#00C2D6' strokeWidth='1.5' opacity='0.30' />
        <circle cx='400' cy='360' r='70' fill='none' stroke='#E8B75A' strokeWidth='2' opacity='0.5' />
        <circle cx='400' cy='360' r='6' fill='#E8B75A' />
        <circle cx='540' cy='360' r='4' fill='#00C2D6' />
      </svg>
    </Box>
    <Box style={{ position: 'absolute', top: 0, left: 0, width: 300, height: 6, background: 'linear-gradient(90deg, #E8B75A 0%, #00C2D6 100%)' }} />
    <Box style={{ position: 'absolute', top: 96, left: 78, width: 4, height: 60, background: 'linear-gradient(180deg, #E8B75A, #00C2D6)', borderRadius: 2 }} />

    <Box style={{ position: 'relative', zIndex: 1, padding: '0 110px', justifyContent: 'center', height: '100%' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 20 }}>
        <Box style={{ width: 30, height: 2, background: '#E8B75A' }} />
        <Text style={{ fontSize: 15, color: '#E8B75A', fontWeight: 600, letterSpacing: 3 }}>SUMMARY</Text>
      </Box>
      <Text style={{ fontSize: 52, fontWeight: 'bold', color: '#FFFFFF', marginBottom: 32 }}>进度小结</Text>

      <Box style={{ flexDirection: 'column', gap: 16, maxWidth: 800 }}>
        {[
          { k: '覆盖完成', v: '1,248 份语料、检索 100%、效力判定全量', ic: 'database', c: '#00D4E8' },
          { k: '测试通过', v: '自研 19/19、审计 12 项全过、validity-QA 84/84', ic: 'check-circle', c: '#5FD09A' },
          { k: '三项短板', v: '可直引率 27%、独立盲评缺失、156 份待补施行日', ic: 'exclamation-triangle', c: '#E8B75A' },
        ].map((r, i) => (
          <Box key={i} style={{ flexDirection: 'row', gap: 18, alignItems: 'center', background: 'rgba(255,255,255,0.07)', border: '1px solid rgba(255,255,255,0.12)', borderRadius: 10, borderLeft: '4px solid ' + r.c, padding: '14px 20px' }}>
            <Box style={{ width: 40, height: 40, borderRadius: 9, background: 'rgba(255,255,255,0.10)', alignItems: 'center', justifyContent: 'center' }}>
              <FAIcon name={r.ic} style={{ fill: r.c, width: 21, height: 21 }} />
            </Box>
            <Text style={{ fontSize: 19, fontWeight: 600, color: r.c, width: 130 }}>{r.k}</Text>
            <Text style={{ fontSize: 18, color: '#E4EDF8', flex: 1 }}>{r.v}</Text>
          </Box>
        ))}
      </Box>

      <Box style={{ flexDirection: 'row', alignItems: 'flex-end', justifyContent: 'space-between', marginTop: 46, maxWidth: 800 }}>
        <Text style={{ fontSize: 56, fontWeight: 'bold', color: '#FFFFFF' }}>谢谢</Text>
        <Text style={{ fontSize: 16, color: '#8FB3DC', marginBottom: 12 }}>Q & A</Text>
      </Box>
    </Box>

    <Box style={{ position: 'absolute', bottom: 0, left: 0, width: '100%', padding: '0 110px 26px 110px' }}>
      <Box style={{ height: 1, background: 'linear-gradient(90deg, rgba(232,183,90,0.7) 0%, rgba(0,194,214,0.4) 40%, transparent 100%)', marginBottom: 14 }} />
      <Text style={{ fontSize: 13, color: '#7E9EC6' }}>项目进度汇报 · 2026-11-22</Text>
    </Box>
  </Box>
</Slide>
