<Slide style={{ width: 1280, height: 720, background: 'linear-gradient(135deg, #F7FAFE 0%, #FFFFFF 55%, #F2F7FD 100%)', padding: 0 }}>
  <Box style={{ position: 'relative', width: '100%', height: '100%', flexDirection: 'column' }}>
    <Box style={{ position: 'absolute', top: 84, right: 0, width: 260, height: 260, opacity: 0.5 }}>
      <svg width={260} height={260} viewBox='0 0 260 260'>
        <circle cx='150' cy='110' r='120' fill='none' stroke='#9DBFE8' strokeWidth='1' opacity='0.4' />
        <circle cx='150' cy='110' r='84' fill='none' stroke='#7FA9DE' strokeWidth='1' opacity='0.5' />
        <circle cx='150' cy='110' r='48' fill='none' stroke='#E8B75A' strokeWidth='1.5' opacity='0.55' />
        <circle cx='234' cy='110' r='4' fill='#E8B75A' />
      </svg>
    </Box>

    <Box style={{ position: 'relative', height: 76, background: 'linear-gradient(90deg, #0A2342 0%, #16457C 100%)', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 60px' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
        <Box style={{ width: 5, height: 34, background: 'linear-gradient(180deg, #E8B75A, #00C2D6)', borderRadius: 3 }} />
        <Text style={{ fontSize: 33, fontWeight: 'bold', color: '#FFFFFF' }}>本轮测试数据</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Text style={{ fontSize: 15, color: '#8FB3DC', letterSpacing: 1 }}>ROUND-01 · 2026-11-22</Text>
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#E8B75A' }}>02</Text>
      </Box>
    </Box>

    <Box style={{ position: 'relative', flex: 1, flexDirection: 'column', padding: '16px 60px 0 60px' }}>
      {/* 批次信息条 */}
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: 'linear-gradient(90deg, #EAF2FC 0%, #F7FAFE 100%)', borderRadius: 8, borderLeft: '3px solid #1E5AA8', padding: '9px 16px', marginBottom: 13 }}>
        <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 7 }}>
          <FAIcon name='check-circle' style={{ fill: '#1A9E5C', width: 12, height: 12 }} />
          <Text style={{ fontSize: 15, fontWeight: 600, color: '#1A2230' }}>批次 2026-11-22_round-01</Text>
        </Box>
        <Text style={{ fontSize: 13.5, color: '#5A6B80' }}>21:20–21:28 · Git a20edc3</Text>
        <Box style={{ flex: 1 }} />
        <Text style={{ fontSize: 13.5, color: '#5A6B80' }}>核心结论</Text>
        <Text style={{ fontSize: 14, fontWeight: 600, color: '#1A9E5C' }}>PASS</Text>
        <Text style={{ fontSize: 13.5, color: '#5A6B80', marginLeft: 10 }}>在线模型</Text>
        <Text style={{ fontSize: 14, fontWeight: 600, color: '#1A9E5C' }}>PASS</Text>
      </Box>

      {/* 四个总体通过卡 */}
      <Box style={{ flexDirection: 'row', gap: 12, marginBottom: 13 }}>
        {[
          { n: '19/19', t: '自研核心测试', ic: 'check-circle', c: '#1E5AA8' },
          { n: '22/22', t: 'Web 服务审计', ic: 'server', c: '#00A8BC' },
          { n: '84/84', t: 'validity-QA', ic: 'clipboard', c: '#D9972A' },
          { n: '10/10', t: '真实 PageIndex', ic: 'cube', c: '#1E5AA8' },
        ].map((k, i) => (
          <Box key={i} style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E3EBF5', borderRadius: 9, boxShadow: '0 4px 14px rgba(10,35,66,0.07)', borderTop: '3px solid ' + k.c, padding: '11px 16px', flexDirection: 'row', alignItems: 'center', gap: 13 }}>
            <Box style={{ width: 40, height: 40, borderRadius: 9, background: k.c + '16', alignItems: 'center', justifyContent: 'center' }}>
              <FAIcon name={k.ic} style={{ fill: k.c, width: 21, height: 21 }} />
            </Box>
            <Box>
              <Text style={{ fontSize: 28, fontWeight: 'bold', color: k.c, lineHeight: 1.1 }}>{k.n}</Text>
              <Text style={{ fontSize: 13.5, color: '#5A6B80' }}>{k.t}</Text>
            </Box>
          </Box>
        ))}
      </Box>

      {/* validity-QA 分项 */}
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 9, marginBottom: 8 }}>
        <FAIcon name='clipboard' style={{ fill: '#D9972A', width: 17, height: 17 }} />
        <Text style={{ fontSize: 18, fontWeight: 600, color: '#0A2342' }}>validity-QA · 84 题分项</Text>
        <Text style={{ fontSize: 13, color: '#5A6B80' }}>答案 57/57 · 引用合规 84/84 · 现行有效题只引现行有效条文 48/48</Text>
      </Box>
      <Box style={{ flexDirection: 'row', gap: 10, marginBottom: 13 }}>
        {[
          { n: '48/48', t: '现行有效', c: '#1E5AA8', ic: 'check-circle' },
          { n: '21/21', t: '失效陷阱', c: '#C0392B', ic: 'times-circle' },
          { n: '8/8', t: '效力存疑', c: '#D9972A', ic: 'info-circle' },
          { n: '6/6', t: '语料外拒答', c: '#6B4FA8', ic: 'times-circle' },
          { n: '1/1', t: '历史时点', c: '#00A8BC', ic: 'clock' },
        ].map((k, i) => (
          <Box key={i} style={{ flex: 1, background: '#FFFFFF', border: '1px solid #E3EBF5', borderRadius: 8, boxShadow: '0 2px 8px rgba(10,35,66,0.05)', padding: '9px 12px' }}>
            <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 7, marginBottom: 3 }}>
              <FAIcon name={k.ic} style={{ fill: k.c, width: 15, height: 15 }} />
              <Text style={{ fontSize: 20, fontWeight: 'bold', color: k.c }}>{k.n}</Text>
            </Box>
            <Text style={{ fontSize: 12.5, color: '#5A6B80' }}>{k.t}</Text>
          </Box>
        ))}
      </Box>

      {/* 12 项离线审计 + 上游 */}
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 9, marginBottom: 8 }}>
        <FAIcon name='shield' style={{ fill: '#1E5AA8', width: 17, height: 17 }} />
        <Text style={{ fontSize: 18, fontWeight: 600, color: '#0A2342' }}>审计矩阵 · 全部离线可复跑</Text>
        <Text style={{ fontSize: 13, color: '#5A6B80' }}>12 项通过 · 效力/引用策略 0 处反向放宽</Text>
      </Box>
      <Box style={{ flexDirection: 'row', gap: 22, flex: 1 }}>
        <Box style={{ flex: 1, flexDirection: 'column' }}>
          {[
            ['推理协议单一来源', '6/6'], ['检索策略路由', '13/13'],
            ['事项目录解析与接入', '7/7'], ['带效力树与 PageIndex 适配', '10/10'],
            ['沿树检索', '8/8'], ['带效力推理检索', '16/16'],
          ].map((r, i) => (
            <Box key={i} style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: '6px 2px', borderBottom: '1px solid #EDF1F7' }}>
              <Text style={{ fontSize: 14.5, color: '#16243A' }}>{r[0]}</Text>
              <Text style={{ fontSize: 14.5, color: '#1E5AA8', fontWeight: 600 }}>{r[1]}</Text>
            </Box>
          ))}
        </Box>
        <Box style={{ flex: 1, flexDirection: 'column' }}>
          {[
            ['历史时点效力计算', '13/13'], ['时点证据索引与降级', '12/12'],
            ['模型 Provider 配置与重试', '10/10'], ['条文级部分废止', '28/28'],
            ['Web 服务与异步 API', '22/22'], ['废止关系名称闸门', '1 处待核验'],
          ].map((r, i) => (
            <Box key={i} style={{ flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', padding: '6px 2px', borderBottom: '1px solid #EDF1F7' }}>
              <Text style={{ fontSize: 14.5, color: '#16243A' }}>{r[0]}</Text>
              <Text style={{ fontSize: 14.5, color: i === 5 ? '#C0392B' : '#1E5AA8', fontWeight: 600 }}>{r[1]}</Text>
            </Box>
          ))}
        </Box>
      </Box>

      {/* 上游说明 */}
      <Box style={{ background: '#FBF2F1', borderRadius: 7, borderLeft: '3px solid #C0392B', padding: '8px 14px', margin: '11px 0 12px 0' }}>
        <Text style={{ fontSize: 13, color: '#5A6B80', lineHeight: 1.45 }}>
          <span style={{ fontWeight: 600, color: '#C0392B' }}>上游 PageIndex 单元测试</span>：668 passed / 77 skipped / 5 failed；5 项均为 Windows 平台前提（符号链接权限、文件名语义、并发命名），未改动上游源码。
        </Text>
      </Box>
    </Box>

    <Box style={{ position: 'relative', height: 34, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 60px' }}>
      <Text style={{ fontSize: 12.5, color: '#9AA6B6' }}>项目进度汇报 · 2026-11-22</Text>
      <Text style={{ fontSize: 12.5, color: '#9AA6B6', fontWeight: 600 }}>03 / 06</Text>
    </Box>
  </Box>
</Slide>
