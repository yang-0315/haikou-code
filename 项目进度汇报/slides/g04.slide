<Slide style={{ width: 1280, height: 720, background: 'linear-gradient(135deg, #F7FAFE 0%, #FFFFFF 55%, #F2F7FD 100%)', padding: 0 }}>
  <Box style={{ position: 'relative', width: '100%', height: '100%', flexDirection: 'column' }}>
    <Box style={{ position: 'absolute', top: 84, right: 0, width: 260, height: 260, opacity: 0.5 }}>
      <svg width={260} height={260} viewBox='0 0 260 260'>
        <circle cx='150' cy='110' r='120' fill='none' stroke='#9DBFE8' strokeWidth='1' opacity='0.4' />
        <circle cx='150' cy='110' r='84' fill='none' stroke='#7FA9DE' strokeWidth='1' opacity='0.5' />
        <circle cx='150' cy='110' r='48' fill='none' stroke='#E8B75A' strokeWidth='1.5' opacity='0.55' />
        <circle cx='234' cy='110' r='4' fill='#E8B75A' />
      </svg>
    </Box>

    <Box style={{ position: 'relative', height: 76, background: 'linear-gradient(90deg, #0A2342 0%, #16457C 100%)', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 60px' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16 }}>
        <Box style={{ width: 5, height: 34, background: 'linear-gradient(180deg, #E8B75A, #00C2D6)', borderRadius: 3 }} />
        <Text style={{ fontSize: 33, fontWeight: 'bold', color: '#FFFFFF' }}>下一步计划</Text>
      </Box>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12 }}>
        <Text style={{ fontSize: 15, color: '#8FB3DC', letterSpacing: 1 }}>NEXT STEPS</Text>
        <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#E8B75A' }}>04</Text>
      </Box>
    </Box>

    <Box style={{ position: 'relative', flex: 1, flexDirection: 'column', padding: '20px 60px 0 60px' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 9, marginBottom: 11 }}>
        <FAIcon name='fire' style={{ fill: '#C0392B', width: 18, height: 18 }} />
        <Text style={{ fontSize: 20, fontWeight: 600, color: '#0A2342' }}>高优先级 · 对应上述三个问题</Text>
      </Box>
      <Box style={{ flexDirection: 'column', gap: 9, marginBottom: 20 }}>
        {[
          ['1', '提高条款可直引率（27% →）', '表格目录按章节做列模板，或争取官方 Excel 版，让条目能直接引原文'],
          ['2', '真正独立的第二人盲评', '由未参与实现者填新匿名表，形成独立一致率与有效 Cohen κ'],
          ['3', '时点日期人工补证 156 份', '按 review_queue.csv 依官方来源补填，回灌覆盖索引'],
          ['4', '建 2024／2022 版指导目录', '同一套流程各约 2–3 分钟，补齐跨年度比对'],
        ].map((r, i) => (
          <Box key={i} style={{ background: '#FFFFFF', border: '1px solid #E3EBF5', borderRadius: 9, boxShadow: '0 3px 12px rgba(10,35,66,0.06)', borderLeft: '4px solid #1E5AA8', padding: '10px 16px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
            <Box style={{ width: 30, height: 30, background: 'linear-gradient(135deg, #1E5AA8, #16457C)', borderRadius: 15, alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>{r[0]}</Text>
            </Box>
            <Text style={{ fontSize: 17, fontWeight: 600, color: '#0A2342', width: 290 }}>{r[1]}</Text>
            <Text style={{ fontSize: 14.5, color: '#5A6B80', flex: 1 }}>{r[2]}</Text>
          </Box>
        ))}
      </Box>

      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 9, marginBottom: 9 }}>
        <FAIcon name='stream' style={{ fill: '#00A8BC', width: 18, height: 18 }} />
        <Text style={{ fontSize: 20, fontWeight: 600, color: '#0A5F78' }}>中优先级 · 随后推进</Text>
      </Box>
      <Box style={{ flexDirection: 'column', gap: 4, flex: 1 }}>
        {[
          ['条文级修改内容补全', '为被改写条文保存新旧文本差异'],
          ['版本分不清的 7 份', '版本谱系＋文号联合判定'],
          ['事项索引持久化', '避免每次查询现场建（约 0.2s）'],
          ['712 份无文号补抽取', '扩大文号检索覆盖'],
          ['反馈式二次路由', '首轮证据不足时自动换路重试'],
        ].map((r, i) => (
          <Box key={i} style={{ flexDirection: 'row', gap: 14, padding: '7px 4px', borderBottom: '1px solid #EDF1F7', alignItems: 'center' }}>
            <FAIcon name='chevron-right' style={{ fill: '#00A8BC', width: 14, height: 14 }} />
            <Text style={{ fontSize: 15.5, color: '#16243A', width: 250, fontWeight: 600 }}>{r[0]}</Text>
            <Text style={{ fontSize: 14.5, color: '#5A6B80', flex: 1 }}>{r[1]}</Text>
          </Box>
        ))}
      </Box>

      <Box style={{ background: 'linear-gradient(90deg, #EAF2FC 0%, #F7FAFE 100%)', borderRadius: 8, borderLeft: '3px solid #E8B75A', padding: '10px 16px', margin: '12px 0 14px 0' }}>
        <Text style={{ fontSize: 14.5, color: '#5A6B80' }}>
          <span style={{ fontWeight: 600, color: '#0A2342' }}>节奏：</span>先补"能引原文、能独立核验、时点完整"，再推进检索策略与版本判定的精细化。
        </Text>
      </Box>
    </Box>

    <Box style={{ position: 'relative', height: 34, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 60px' }}>
      <Text style={{ fontSize: 12.5, color: '#9AA6B6' }}>项目进度汇报 · 2026-11-22</Text>
      <Text style={{ fontSize: 12.5, color: '#9AA6B6', fontWeight: 600 }}>05 / 06</Text>
    </Box>
  </Box>
</Slide>
