<Slide style={{ width: 1280, height: 720, background: 'linear-gradient(155deg, #F5F9FF 0%, #FFFFFF 50%, #EDF3FC 100%)', padding: 0 }}>
  <Box style={{ position: 'relative', width: '100%', height: '100%', flexDirection: 'column' }}>
    <Box style={{ position: 'absolute', top: 72, right: 0, width: 260, height: 260, background: 'linear-gradient(225deg, #DCE8F7 0%, #FFFFFF 100%)', opacity: 0.6, borderRadius: '0 0 0 130px' }} />

    <Box style={{ position: 'relative', height: 72, background: 'linear-gradient(90deg, #1E4FA8 0%, #3D7BD9 100%)', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 60px' }}>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>现存问题 · 最重要的三项</Text>
      <Text style={{ fontSize: 16, color: '#DCE8F7' }}>02 · KEY ISSUES</Text>
    </Box>

    <Box style={{ position: 'relative', flex: 1, flexDirection: 'column', padding: '20px 60px 0 60px' }}>
      <Text style={{ fontSize: 16, color: '#4A5568', marginBottom: 16 }}>
        选自 progress.md 高优先级待办，按对交付质量的影响排序；每项说明现象、成因、影响与处理。
      </Text>

      {[
        {
          n: '01', t: '条款可直引率仅 27%', c: '#C0392B',
          a: '2,839 个事项中仅 27% 能直引原文，其余只给事项名＋法律名＋核对提示。',
          b: '网页正文列式摊平，改从 PDF 用字符坐标还原 6 列；后段章节列位偏移。',
          c: '这部分回答不能引原文，用户须自行核对，削弱可溯源性。',
          d: '按章节做列模板，或争取官方 Excel 版（最高优先级）。',
        },
        {
          n: '02', t: '独立第二人盲评缺失', c: '#B8860B',
          a: 'A/B 两表 80/80 通过、κ=1.000，但报告标记为"非独立"，非两名评审者。',
          b: '两表来自同一所有者确认后转录，κ 高只说明自我一致。',
          c: '不能作为"独立人工评测"证据，评测可信度受限。',
          d: '由未参与实现者填新匿名表，形成独立一致率与有效 κ。',
        },
        {
          n: '03', t: '156 份缺明确施行日', c: '#1E4FA8',
          a: '1,248 份入时点索引：明确施行日 635、发布型 305、需人工补证 156。',
          b: '源网页未写施行日；发布型按发布日处理，法规类缺日期无法推断。',
          c: '涉及时点查询时只能保守降为"效力存疑"，无法给确定答案。',
          d: '待补队列在 review_queue.csv，按官方来源补填后回灌覆盖索引。',
        },
      ].map((it, i) => (
        <Box key={i} style={{ background: 'linear-gradient(135deg, #FFFFFF 0%, #F7F9FC 100%)', border: '1px solid #D6DCE5', borderLeft: '5px solid ' + it.c, padding: '14px 20px', marginBottom: 14 }}>
          <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 12, marginBottom: 8 }}>
            <Text style={{ fontSize: 22, fontWeight: 'bold', color: it.c }}>{it.n}</Text>
            <Text style={{ fontSize: 23, fontWeight: 600, color: '#1A2230' }}>{it.t}</Text>
          </Box>
          <Box style={{ flexDirection: 'row', gap: 20 }}>
            <Box style={{ flex: 1, flexDirection: 'row', gap: 8 }}>
              <Text style={{ fontSize: 14, fontWeight: 600, color: it.c, width: 34 }}>现象</Text>
              <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.5, flex: 1 }}>{it.a}</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'row', gap: 8 }}>
              <Text style={{ fontSize: 14, fontWeight: 600, color: it.c, width: 34 }}>成因</Text>
              <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.5, flex: 1 }}>{it.b}</Text>
            </Box>
          </Box>
          <Box style={{ flexDirection: 'row', gap: 20, marginTop: 6 }}>
            <Box style={{ flex: 1, flexDirection: 'row', gap: 8 }}>
              <Text style={{ fontSize: 14, fontWeight: 600, color: '#1E4FA8', width: 34 }}>影响</Text>
              <Text style={{ fontSize: 14, color: '#4A5568', lineHeight: 1.5, flex: 1 }}>{it.c}</Text>
            </Box>
            <Box style={{ flex: 1, flexDirection: 'row', gap: 8 }}>
              <Text style={{ fontSize: 14, fontWeight: 600, color: '#1E4FA8', width: 34 }}>处理</Text>
              <Text style={{ fontSize: 14, color: '#1A2230', fontWeight: 600, lineHeight: 1.5, flex: 1 }}>{it.d}</Text>
            </Box>
          </Box>
        </Box>
      ))}
    </Box>

    <Box style={{ position: 'relative', height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 60px' }}>
      <Text style={{ fontSize: 14, color: '#8B97A8' }}>项目进度汇报 · 2026-11-22</Text>
      <Text style={{ fontSize: 14, color: '#8B97A8' }}>03 / 05</Text>
    </Box>
  </Box>
</Slide>
