<Slide style={{ width: 1280, height: 720, background: 'linear-gradient(155deg, #F5F9FF 0%, #FFFFFF 50%, #EDF3FC 100%)', padding: 0 }}>
  <Box style={{ position: 'relative', width: '100%', height: '100%', flexDirection: 'column' }}>
    <Box style={{ position: 'absolute', top: 72, right: 0, width: 260, height: 260, background: 'linear-gradient(225deg, #DCE8F7 0%, #FFFFFF 100%)', opacity: 0.6, borderRadius: '0 0 0 130px' }} />

    <Box style={{ position: 'relative', height: 72, background: 'linear-gradient(90deg, #1E4FA8 0%, #3D7BD9 100%)', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 60px' }}>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>下一步计划</Text>
      <Text style={{ fontSize: 16, color: '#DCE8F7' }}>03 · NEXT STEPS</Text>
    </Box>

    <Box style={{ position: 'relative', flex: 1, flexDirection: 'column', padding: '24px 60px 0 60px' }}>
      <Text style={{ fontSize: 21, fontWeight: 600, color: '#1E4FA8', marginBottom: 12 }}>高优先级 · 对应上述三个问题</Text>
      <Box style={{ flexDirection: 'column', gap: 10, marginBottom: 22 }}>
        {[
          ['1', '提高条款可直引率（27% →）', '表格目录按章节做列模板，或争取官方 Excel 版，让条目能直接引原文'],
          ['2', '真正独立的第二人盲评', '由未参与实现者填新匿名表，形成独立一致率与有效 Cohen κ'],
          ['3', '时点日期人工补证 156 份', '按 review_queue.csv 依官方来源补填，回灌覆盖索引'],
          ['4', '建 2024／2022 版指导目录', '同一套流程各约 2–3 分钟，补齐跨年度比对'],
        ].map((r, i) => (
          <Box key={i} style={{ background: '#FFFFFF', border: '1px solid #D6DCE5', borderLeft: '4px solid #1E4FA8', padding: '10px 16px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
            <Box style={{ width: 28, height: 28, background: 'linear-gradient(135deg, #1E4FA8, #3D7BD9)', borderRadius: 14, alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#FFFFFF' }}>{r[0]}</Text>
            </Box>
            <Text style={{ fontSize: 18, fontWeight: 600, color: '#1A2230', width: 280 }}>{r[1]}</Text>
            <Text style={{ fontSize: 15, color: '#4A5568', flex: 1 }}>{r[2]}</Text>
          </Box>
        ))}
      </Box>

      <Text style={{ fontSize: 21, fontWeight: 600, color: '#3D7BD9', marginBottom: 10 }}>中优先级 · 随后推进</Text>
      <Box style={{ flexDirection: 'column', gap: 6, flex: 1 }}>
        {[
          ['条文级修改内容补全', '为被改写条文保存新旧文本差异'],
          ['版本分不清的 7 份', '版本谱系＋文号联合判定'],
          ['事项索引持久化', '避免每次查询现场建（约 0.2s）'],
          ['712 份无文号补抽取', '扩大文号检索覆盖'],
          ['反馈式二次路由', '首轮证据不足时自动换路重试'],
        ].map((r, i) => (
          <Box key={i} style={{ flexDirection: 'row', gap: 14, padding: '7px 0', borderBottom: '1px solid #E5E7EB' }}>
            <Text style={{ fontSize: 16, color: '#3D7BD9', fontWeight: 'bold' }}>▸</Text>
            <Text style={{ fontSize: 16, color: '#1A2230', width: 250 }}>{r[0]}</Text>
            <Text style={{ fontSize: 15, color: '#4A5568', flex: 1 }}>{r[1]}</Text>
          </Box>
        ))}
      </Box>

      <Box style={{ background: 'linear-gradient(90deg, #E8EFF8 0%, #FFFFFF 100%)', borderLeft: '3px solid #1E4FA8', padding: '10px 16px', marginTop: 12, marginBottom: 16 }}>
        <Text style={{ fontSize: 15, color: '#4A5568' }}>
          <span style={{ fontWeight: 600, color: '#1E4FA8' }}>节奏：</span>先补"能引原文、能独立核验、时点完整"，再推进检索策略与版本判定的精细化。
        </Text>
      </Box>
    </Box>

    <Box style={{ position: 'relative', height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 60px' }}>
      <Text style={{ fontSize: 14, color: '#8B97A8' }}>项目进度汇报 · 2026-11-22</Text>
      <Text style={{ fontSize: 14, color: '#8B97A8' }}>04 / 05</Text>
    </Box>
  </Box>
</Slide>
