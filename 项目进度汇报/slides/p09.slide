<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 0 }}>
  <Box style={{ width: '100%', height: '100%', flexDirection: 'column' }}>
    <Box style={{ height: 72, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 60px' }}>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>下一步计划</Text>
      <Text style={{ fontSize: 16, color: '#C9DAF5' }}>04 · NEXT STEPS</Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', padding: '22px 60px 0 60px' }}>
      <Text style={{ fontSize: 21, fontWeight: 600, color: '#1E4FA8', marginBottom: 10 }}>高优先级（先行）</Text>
      <Box style={{ flexDirection: 'column', gap: 8, marginBottom: 18 }}>
        {[
          ['1', '提高条款可直引率（27% →）', '表格目录按章节做列模板，或争取官方 Excel 版；让条目能直接引原文'],
          ['2', '建 2024／2022 版指导目录', '同一套流程各约 2–3 分钟即可建好'],
          ['3', '真正独立的第二人盲评', '由未参与实现者填新匿名表，形成独立一致率与 Cohen κ'],
          ['4', '时点日期人工补证 156 份', '按 review_queue.csv 依官方来源补填，回灌覆盖索引'],
        ].map((r, i) => (
          <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 14, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: '8px 14px' }}>
            <Box style={{ width: 26, height: 26, background: '#1E4FA8', borderRadius: 13, alignItems: 'center', justifyContent: 'center' }}>
              <Text style={{ fontSize: 14, fontWeight: 'bold', color: '#FFFFFF' }}>{r[0]}</Text>
            </Box>
            <Text style={{ fontSize: 17, fontWeight: 600, color: '#1A2230', width: 250 }}>{r[1]}</Text>
            <Text style={{ fontSize: 15, color: '#4A5568', flex: 1 }}>{r[2]}</Text>
          </Box>
        ))}
      </Box>

      <Text style={{ fontSize: 21, fontWeight: 600, color: '#3D7BD9', marginBottom: 10 }}>中优先级（随后）</Text>
      <Box style={{ flexDirection: 'column', gap: 7, flex: 1 }}>
        {[
          ['条文级修改内容补全', '被改写条文保存新旧文本差异'],
          ['版本分不清的 7 份', '版本谱系 + 文号联合判定'],
          ['事项索引持久化', '避免每次查询现场建（约 0.2s）'],
          ['712 份无文号补抽取', '扩大文号检索覆盖'],
          ['反馈式二次路由', '首轮证据不足时自动换路重试'],
        ].map((r, i) => (
          <Box key={i} style={{ flexDirection: 'row', gap: 14, padding: '6px 0', borderBottom: '1px solid #E5E7EB' }}>
            <Text style={{ fontSize: 16, color: '#3D7BD9', fontWeight: 'bold' }}>▸</Text>
            <Text style={{ fontSize: 16, color: '#1A2230', width: 240 }}>{r[0]}</Text>
            <Text style={{ fontSize: 15, color: '#4A5568', flex: 1 }}>{r[1]}</Text>
          </Box>
        ))}
      </Box>

      <Box style={{ background: '#E8EFF8', padding: '12px 18px', marginTop: 12, marginBottom: 16 }}>
        <Text style={{ fontSize: 15, color: '#4A5568' }}>
          <span style={{ fontWeight: 'bold', color: '#1E4FA8' }}>节奏：</span>先把「能引原文、能独立核验、时点完整」补齐，再推进检索策略与版本判定的精细化。
        </Text>
      </Box>
    </Box>

    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 60px' }}>
      <Text style={{ fontSize: 14, color: '#8B97A8' }}>项目进度汇报 · 2026-11-22</Text>
      <Text style={{ fontSize: 14, color: '#8B97A8' }}>09 / 10</Text>
    </Box>
  </Box>
</Slide>
