<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 0 }}>
  <Box style={{ width: '100%', height: '100%', flexDirection: 'column', padding: '60px 80px 40px 80px' }}>
    <Text style={{ fontSize: 36, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1.2 }}>目录</Text>
    <Text style={{ fontSize: 16, color: '#8B97A8', letterSpacing: 2, marginTop: 4 }}>CONTENTS</Text>
    <Box style={{ height: 1, background: '#D6DCE5', marginTop: 16, marginBottom: 28 }} />
    <Box style={{ flexDirection: 'column', gap: 12 }}>
      {[
        { n: '01', t: '当前进度', d: '语料、索引、效力判定的规模与覆盖' },
        { n: '02', t: '本轮测试数据', d: '批次总览、84 题评测、审计与真实客户端' },
        { n: '03', t: '存在的问题（3 页详解）', d: '数据质量 / 技术能力 / 工程与评测，逐条说明成因与影响' },
        { n: '04', t: '下一步计划', d: '高优先级补强项与实施顺序' },
      ].map((it, i) => (
        <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 24, padding: '14px 0' }}>
          <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#1E4FA8', width: 68 }}>{it.n}</Text>
          <Box style={{ width: 1, height: 44, background: '#D6DCE5' }} />
          <Box style={{ flexDirection: 'column', gap: 3 }}>
            <Text style={{ fontSize: 24, fontWeight: 600, color: '#1A2230' }}>{it.t}</Text>
            <Text style={{ fontSize: 16, color: '#8B97A8' }}>{it.d}</Text>
          </Box>
        </Box>
      ))}
    </Box>
  </Box>
</Slide>
