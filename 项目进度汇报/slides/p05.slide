<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', padding: 0 }}>
  <Box style={{ width: '100%', height: '100%', flexDirection: 'column' }}>
    <Box style={{ height: 72, background: '#1E4FA8', flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 60px' }}>
      <Text style={{ fontSize: 34, fontWeight: 'bold', color: '#FFFFFF' }}>本轮测试 · validity-QA 84 题</Text>
      <Text style={{ fontSize: 16, color: '#C9DAF5' }}>02 · TEST RESULTS</Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', padding: '24px 60px 0 60px' }}>
      <Box style={{ flexDirection: 'row', gap: 20, marginBottom: 18 }}>
        <Box style={{ flex: 1, border: '1px solid #D6DCE5', borderTop: '3px solid #1E4FA8', padding: '14px 20px' }}>
          <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#1E4FA8', lineHeight: 1.1 }}>84/84</Text>
          <Text style={{ fontSize: 17, color: '#4A5568', marginTop: 4 }}>总正确率 100%</Text>
        </Box>
        <Box style={{ flex: 1, border: '1px solid #D6DCE5', borderTop: '3px solid #3D7BD9', padding: '14px 20px' }}>
          <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#3D7BD9', lineHeight: 1.1 }}>57/57</Text>
          <Text style={{ fontSize: 17, color: '#4A5568', marginTop: 4 }}>答案对（证据＋要点齐）</Text>
        </Box>
        <Box style={{ flex: 1, border: '1px solid #D6DCE5', borderTop: '3px solid #3D7BD9', padding: '14px 20px' }}>
          <Text style={{ fontSize: 46, fontWeight: 'bold', color: '#3D7BD9', lineHeight: 1.1 }}>84/84</Text>
          <Text style={{ fontSize: 17, color: '#4A5568', marginTop: 4 }}>引用合规（无未标注失效引用）</Text>
        </Box>
      </Box>

      <Text style={{ fontSize: 20, fontWeight: 600, color: '#1E4FA8', marginBottom: 10 }}>五类题型分项（全部通过）</Text>
      <Box style={{ flexDirection: 'row', gap: 12, marginBottom: 18 }}>
        {[
          { n: '48/48', t: '现行有效', d: '只引现行有效条文' },
          { n: '21/21', t: '失效陷阱', d: '引废止条文均明确标注' },
          { n: '8/8', t: '效力存疑', d: '提示需核实' },
          { n: '6/6', t: '语料外', d: '正确拒答' },
          { n: '1/1', t: '历史时点', d: 'v4 新增' },
        ].map((k, i) => (
          <Box key={i} style={{ flex: 1, background: '#F7F9FC', border: '1px solid #D6DCE5', padding: '12px 10px' }}>
            <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1E4FA8' }}>{k.n}</Text>
            <Text style={{ fontSize: 17, fontWeight: 600, color: '#1A2230', marginTop: 4 }}>{k.t}</Text>
            <Text style={{ fontSize: 13, color: '#8B97A8', marginTop: 3, lineHeight: 1.35 }}>{k.d}</Text>
          </Box>
        ))}
      </Box>

      <Text style={{ fontSize: 20, fontWeight: 600, color: '#1E4FA8', marginBottom: 10 }}>本轮新增：4 道路由覆盖题（全通过）</Text>
      <Box style={{ flexDirection: 'column', gap: 8, flex: 1 }}>
        {[
          ['cov-01', '精确条号提问', 'in_force · 现行有效'],
          ['cov-02', '多文档比较', 'trap · 引废止但已标注'],
          ['cov-03', '事项目录提问', 'in_force · 现行有效'],
          ['cov-04', '历史时点提问', 'temporal · 时点效力'],
        ].map((r, i) => (
          <Box key={i} style={{ flexDirection: 'row', alignItems: 'center', gap: 16, background: '#FFFFFF', border: '1px solid #E5E7EB', padding: '8px 14px' }}>
            <Text style={{ fontSize: 15, fontWeight: 'bold', color: '#1E4FA8', width: 70 }}>{r[0]}</Text>
            <Text style={{ fontSize: 17, color: '#1A2230', flex: 1 }}>{r[1]}</Text>
            <Text style={{ fontSize: 14, color: '#8B97A8' }}>{r[2]}</Text>
          </Box>
        ))}
      </Box>

      <Box style={{ background: '#E8EFF8', padding: '12px 18px', marginTop: 14, marginBottom: 16 }}>
        <Text style={{ fontSize: 15, color: '#4A5568' }}>
          评测口径：答案正确性 + 引用效力正确性双维；题集由 80 题扩至 84 题（v2 30 + v3 50 + v4 新增 4）。
        </Text>
      </Box>
    </Box>

    <Box style={{ height: 40, flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', padding: '0 60px' }}>
      <Text style={{ fontSize: 14, color: '#8B97A8' }}>项目进度汇报 · 2026-11-22</Text>
      <Text style={{ fontSize: 14, color: '#8B97A8' }}>05 / 10</Text>
    </Box>
  </Box>
</Slide>
