          ['条文级部分废止', '从修改决定提取删条/删款项事件，检索链路各层统一使用条文级状态'],
          ['用户服务入口', '本机 Web 页面 + 异步 JSON API，支持提问、历史时点、效力状态、拒答与引用展示'],
        ].map((r, i) => (
          <Box key={i} style={{ flexDirection: 'row', gap: 16, borderLeft: '3px solid #3D7BD9', padding: '6px 0 6px 14px' }}>
