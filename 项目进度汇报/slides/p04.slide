      <Text style={{ fontSize: 16, color: '#C9DAF5' }}>02 · TEST RESULTS</Text>
    </Box>

    <Box style={{ flex: 1, flexDirection: 'column', padding: '24px 60px 0 60px' }}>
      <Box style={{ flexDirection: 'row', alignItems: 'center', gap: 16, marginBottom: 16 }}>
        <Box style={{ background: '#E8EFF8', padding: '8px 14px' }}>
          <Text style={{ fontSize: 16, fontWeight: 600, color: '#1E4FA8' }}>批次 2026-11-22_round-01</Text>
        </Box>
        <Text style={{ fontSize: 15, color: '#4A5568' }}>21:20–21:28 · Git a20edc3 · 核心结论 PASS · 在线模型 PASS</Text>
      </Box>

      <Box style={{ flexDirection: 'row', gap: 16, marginBottom: 18 }}>
        {[
          { n: '19/19', t: '自研核心测试', c: '#1E4FA8' },
          { n: '22/22', t: 'Web 服务审计', c: '#1E4FA8' },
          { n: '84/84', t: 'validity-QA', c: '#1E4FA8' },
        ].map((k, i) => (
          <Box key={i} style={{ flex: 1, border: '1px solid #D6DCE5', padding: '12px 18px', flexDirection: 'row', alignItems: 'center', gap: 16 }}>
            <Text style={{ fontSize: 36, fontWeight: 'bold', color: k.c }}>{k.n}</Text>
            <Text style={{ fontSize: 17, color: '#4A5568' }}>{k.t}</Text>
          </Box>
        ))}
      </Box>

      <Text style={{ fontSize: 20, fontWeight: 600, color: '#1E4FA8', marginBottom: 10 }}>本轮完成事项（6 个模块）</Text>
      <Box style={{ flexDirection: 'column', gap: 10, flex: 1 }}>
        {[
          ['测试基础设施', '新增批量测试脚本，逐条捕获输出/退出码/耗时/环境快照，结果独立归档；历史材料统一快照 52 份'],
          ['评测集扩至 84 题', '基础 30 + 新增 50 + v4 路由覆盖 4；数据契约校验通过，自动评测全对'],
          ['时点证据完整性', '正式索引覆盖 1,248 份：明确施行日 635、政策发布型 305、需人工补证 156'],
