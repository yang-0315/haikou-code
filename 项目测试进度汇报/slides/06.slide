    <Box style={{ height: 408, flexDirection: 'row', gap: 32 }}>

      <Box style={{ width: 250, height: 408, padding: 26, borderRadius: 10, background: 'linear-gradient(155deg, #1E4FA8 0%, #103A67 100%)', justifyContent: 'space-between' }}>
